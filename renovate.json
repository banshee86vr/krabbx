{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>banshee86vr/renovate-preset"],
  "packageRules": [
    {
      "description": "Keep backend/frontend on TypeScript 6 until typescript-eslint supports the TS 7 API",
      "matchPackageNames": ["typescript"],
      "matchFileNames": ["backend/package.json", "frontend/package.json"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
